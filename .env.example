# Digital Heroes — Environment Variables
# Copy this file to .env.local or .env for development.

# --- Database (Required) ---
# PostgreSQL connection string (Supabase, Neon, RDS, or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/digitalheroes"

# Optional: set to "false" if using local PostgreSQL without SSL
# DATABASE_SSL="false"

# --- Stripe Integration (Optional) ---
# When omitted, the platform runs in full Demo Gateway mode with mock checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Application URL (Optional) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
